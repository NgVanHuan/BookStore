@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}
<section id="mu-user-profile" style="padding: 90px 0 0px">
    <div class="container">
        <h3 style="padding: 375px 0 0">@ViewData["Title"]</h3>
        <partial name="_StatusMessage" for="StatusMessage" />
        <div class="row">
            <div class="col-md-8">
                <form id="profile-form" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-floating">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" disabled />
                    </div>
                    <div class="form-floating">
                        <label asp-for="Input.Customer.FirstName" class="form-label"></label>
                        <input asp-for="Input.Customer.FirstName" class="form-control" />
                        <span asp-validation-for="Input.Customer.FirstName" class="text-danger"></span>
                    </div>
                    <div class="form-floating">
                        <label asp-for="Input.Customer.LastName" class="form-label"></label>
                        <input asp-for="Input.Customer.LastName" class="form-control" />
                        <span asp-validation-for="Input.Customer.LastName" class="text-danger"></span>
                    </div>
                    <div class="form-floating">
                        <label asp-for="Input.PhoneNumber" class="form-label"></label>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="form-floating">
                        <label asp-for="Input.customerAddress" class="form-label"></label>
                        <p>Ex: Street Number, Street Name, City, Country</p>
                        <input asp-for="Input.customerAddress" class="form-control" />
                        <span asp-validation-for="Input.customerAddress" class="text-danger"></span>
                    </div>
                    <button id="update-profile-button" type="submit" class="w-100 btn btn-lg btn-warning" style="margin-top: 20px">Save</button>
                </form>
            </div>
            <div class="col-md-4">
                <h4>Customer Information</h4>
                <p><strong style="font-weight:bold">Full Name:</strong> @Model.Input.Customer?.FirstName @Model.Input.Customer?.LastName</p>
                @* <p><strong style="font-weight:bold">Last Name:</strong> @Model.Input.Customer?.LastName</p> *@
                <p><strong style="font-weight:bold">Email:</strong> @Model.Input.Customer?.Email</p>
                <p><strong style="font-weight:bold">Phone:</strong> @Model.Input?.PhoneNumber</p>
                <p><strong>Address:</strong> @Model.Input?.customerAddress</p>
                <hr />
                <a asp-area="Identity" asp-page="/Account/Manage/ChangePassword" class="btn btn-warning">Change Password</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
