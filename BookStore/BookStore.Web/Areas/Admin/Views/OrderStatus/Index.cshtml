@model IEnumerable<BookStore.VModels.OrderStatus.OrderStatusViewModel>

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">OrderStatus</h1>
    <p class="mb-4">
        List Order Status.
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        @* <div class="card-header py-3"> *@
        @*     <h6 class="m-0 font-weight-bold text-primary"> *@
        @*         <a asp-area="Admin" asp-controller="OrderStatus" asp-action="Create" type="button" class="btn btn-success">Create Order Status</a> *@
        @*     </h6> *@
        @* </div> *@
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-striped table-bordered" style="width:100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Status Id</th>
                            <th>Status Value</th>
                            @* <th>Action</th> *@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.StatusId</td>
                                <td>@item.StatusValue</td>
                                @* <td> *@
                                    @* <button type="button" class="btn btn-info">Info</button> *@
                                    @* <a type="button" asp-area="Admin" asp-controller="OrderStatus" asp-action="Edit" asp-route-statusId="@item.StatusId" class="btn btn-warning">Edit</a> *@
                                    @* <a type="button" asp-area="Admin" asp-controller="OrderStatus" asp-action="Delete" asp-route-statusId="@item.StatusId" class="btn btn-danger" onclick="return confirmDelete()">Delete</a> *@
                                @* </td> *@
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Status Id</th>
                            <th>Status Value</th>
                            @* <th>Action</th> *@
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this author?');
    }
</script>