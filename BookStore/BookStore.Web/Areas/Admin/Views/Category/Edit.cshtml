@using BookStore.VModels.Category
@model CategoryViewModel

<form method="post" asp-area="Admin" asp-action="Edit" style="width:90%; margin: 0 auto;" enctype="multipart/form-data">
	<div class="border p-3 mt-4">
		<div class="row pb-6">
			<h2 class="text-primary">Edit Category</h2>
			<hr />
		</div>
		@*<div asp-validation-summary="All"></div>*@
		<div class="mb-3">
			<input type="hidden" asp-for="CategoryId" />
		</div>
		<div class="mb-3">
			<label asp-for="CategoryName">Category Name</label>
			<input asp-for="CategoryName" class="form-control" />
			<span asp-validation-for="CategoryName" class="text-danger"></span>
		</div>
		<button type="submit" class="btn btn-primary" style="width:150px">Edit</button>
		<a asp-controller="Category" asp-action="Index" class="btn btn-secondary" style="width:150px">
			Back to List
		</a>
	</div>
</form>