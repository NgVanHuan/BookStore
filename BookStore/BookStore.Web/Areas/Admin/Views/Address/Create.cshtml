@using BookStore.VModels.Address
@model AddressViewModel

<form method="post" asp-action="Create" style="width:90%; margin: 0 auto;" enctype="multipart/form-data">
	<div class="border p-3 mt-4" >
		<div class="row pb-6">
			<h2 class="text-primary">Create Address</h2>
			<hr />
		</div>
		@*<div asp-validation-summary="All"></div>*@
		<div class="mb-3">
			<input type="hidden" asp-for="AddressId"/>
		</div>
		<div class="mb-3">
			<label asp-for="StreetNumber">Street Number</label>
			<input asp-for="StreetNumber" class="form-control" />
			<span asp-validation-for="StreetNumber" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="StreetName">Street Name</label>
			<input asp-for="StreetName" class="form-control" />
			<span asp-validation-for="StreetName" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="City">City</label>
			<input asp-for="City" class="form-control" />
			<span asp-validation-for="City" class="text-danger"></span>
		</div>
		<div class="mb-3">
			<label asp-for="CountryId">Country Name</label>
			<select asp-for="CountryId" asp-items="@ViewBag.CountryList" class="form-control">
				<option disabled selected>--Select Country--</option>
			</select>
			<span asp-validation-for="CountryId" class="text-danger"></span>
		</div>
		<button type="submit" class="btn btn-primary" style="width:150px">Create</button>
		<a asp-controller="Address" asp-action="Index" class="btn btn-secondary" style="width:150px">
			Back to List
		</a>
	</div>
</form>