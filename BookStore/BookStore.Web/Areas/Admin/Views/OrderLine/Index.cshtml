@model BookStore.Web.Areas.Admin.Controllers.OrderLineController.OrderManager

@{
    var statusList = new List<string> { "All", "Pending", "Processing", "Shipped", "Returned", "Cancelled" };
    var selectedStatus = ViewBag.SelectedStatus as string ?? "All";
}

<!-- Begin Page Content -->
<div class="container-fluid">
    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Order Manager</h1>
    @* <p class="mb-4"> *@
    @*     --- *@
    @* </p> *@
    <form method="get" asp-area="Admin" asp-controller="OrderLine" asp-action="Index" class="form-inline mb-3">
        <label for="status" class="mr-2">Order Status:</label>
        <select id="status" name="status" class="form-control mr-2" onchange="this.form.submit()">
            @foreach (var s in statusList)
            {
                if (selectedStatus == s)
                {
                    <option value="@s" selected="selected">@s</option>
                }
                else
                {
                    <option value="@s">@s</option>
                }
            }
        </select>
        <noscript><button type="submit" class="btn btn-primary">Filter</button></noscript>
    </form>
    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-body">
            @if (Model.CustomerOrderVModel != null && Model.CustomerOrderVModel.Any())
            {
                foreach (var customerGroup in Model.CustomerOrderVModel.GroupBy(o => o.Customer))
                {
                    <h4 style="margin-top:30px; color:#007bff;">
                        Customer: @customerGroup.Key?.FirstName @customerGroup.Key?.LastName (@customerGroup.Key?.Email)
                    </h4>
                    foreach (var order in customerGroup.OrderByDescending(o => o.OrderDate))
                    {
                        var status = order.OrderHistories?
                        .OrderByDescending(h => h.StatusDate)
                        .FirstOrDefault()?.OrderStatus?.StatusValue ?? "Unknown";
                        <div class="panel panel-default" style="margin-bottom: 20px;">
                            <div class="panel-heading" style="background: #f5f5f5; padding: 10px 15px;">
                                <strong>Order ID:</strong> @order.OrderId
                                <span style="margin-left: 30px;"><strong>Order Date:</strong> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                                <span style="margin-left: 30px;"><strong>Status:</strong> @status</span>
                                <span style="margin-left: 30px;"><strong>Total Amount:</strong> @order.OrderLines?.Sum(ol => ol.Price * ol.Quantity).ToString("C")</span>
                            </div>
                            <div class="panel-body" style="padding: 0;">
                                <table class="table table-bordered" style="margin-bottom: 0;">
                                    <thead>
                                        <tr>
                                            <th>Book Title</th>
                                            <th>Image</th>
                                            <th>Price</th>
                                            <th>Quantity</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in order.OrderLines)
                                        {
                                            <tr>
                                                <td>@line.Book?.Title</td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(line.Book?.ImageName))
                                                    {
                                                        <img src="~/img/book/@line.Book.ImageName" alt="Book Image" style="width:50px; height:75px;" />
                                                    }
                                                </td>
                                                <td>@line.Price.ToString("C")</td>
                                                <td>@line.Quantity</td>
                                                <td>@{var total = (line.Price * line.Quantity).ToString("C");}@total</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (status == "Pending" || status == "Processing")
                            {
                                <div class="panel panel-footer" style="background: #fafafa; padding: 10px 15px; text-align: right">
                                    <form asp-area="Admin" asp-controller="OrderLine" asp-action="ChangeStatus" method="post" style="display:inline;">
                                        <input type="hidden" name="orderId" value="@order.OrderId" />
                                        <input type="hidden" name="currentStatus" value="@selectedStatus" />
                                        <select name="newStatus" class="form-control" style="width:auto;display:inline;">
                                            <option value="Pending">Pending</option>
                                            <option value="Processing">Processing</option>
                                            <option value="Shipped">Shipped</option>
                                            <option value="Cancelled">Cancelled</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary">Change</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }
                }
            }
            else
            {
                <p>No order status: <strong>@selectedStatus</strong> found.</p>
            }
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this Order Line?');
    }
</script>
