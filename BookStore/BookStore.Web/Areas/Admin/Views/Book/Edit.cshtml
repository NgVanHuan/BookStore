@using BookStore.VModels.Books
@model CreateBookViewModel

<form method="post" asp-area="Admin" asp-asp-controller="Book" asp-action="Edit" style="width:90%; margin: 0 auto;" enctype="multipart/form-data">
    <div class="border p-3 mt-4">
        <div class="row pb-6">
            <h2 class="text-primary">Edit Book</h2>
            <hr />
        </div>
        @*<div asp-validation-summary="All"></div>*@
        <div class="mb-3">
            <input type="hidden" asp-for="BookVModel.BookId" />
            <input type="hidden" asp-for="BookVModel.ImageName" />
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.Title">Title</label>
            <input asp-for="BookVModel.Title" class="form-control" />
            <span asp-validation-for="BookVModel.Title" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.IBSN13">IBSN13</label>
            <input asp-for="BookVModel.IBSN13" class="form-control" />
            <span asp-validation-for="BookVModel.IBSN13" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="d-block">Book Photo</label>
            <label class="d-block" id="fileLabel" asp-for="BookVModel.ImageFile" onclick="document.getElementById('ufile').click()" style="cursor: pointer;">Select book photo</label>
            <img id="output" width="300" height="300" alt="Photo" src="@Model.BookVModel.ImageUrl" onclick="document.getElementById('ufile').click()" style="cursor: pointer;" />
            <input asp-for="BookVModel.ImageFile" id="ufile" type="file" style="display: none" onchange="loadFile(event)" />
            <span asp-validation-for="BookVModel.ImageFile" class="text-danger"></span>
            <div id="fileName" style="margin-top: 10px; text-align: left;"></div>
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.LanguageId">Book Language</label>
            <select asp-for="BookVModel.LanguageId" asp-items="@ViewBag.BookLanguageList" class="form-control">
                <option disabled selected>--Select Book Language--</option>
            </select>
            <span asp-validation-for="BookVModel.LanguageId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.NumPages">Num Pages</label>
            <input type="number" asp-for="BookVModel.NumPages" class="form-control" />
            <span asp-validation-for="BookVModel.NumPages" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.Price">Price</label>
            <input type="number" step="0.01" asp-for="BookVModel.Price" class="form-control" />
            <span asp-validation-for="BookVModel.Price" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.PublicationDate">Publication Date</label>
            <input type="date" asp-for="BookVModel.PublicationDate" class="form-control" />
            <span asp-validation-for="BookVModel.PublicationDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.CategoryId">Category Name</label>
            <select asp-for="BookVModel.CategoryId" asp-items="@ViewBag.CategoryList" class="form-control">
                <option disabled selected>--Select Category--</option>
            </select>
            <span asp-validation-for="BookVModel.CategoryId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="BookVModel.PublisherId">Publisher</label>
            <select asp-for="BookVModel.PublisherId" asp-items="@ViewBag.PublisherList" class="form-control">
                <option disabled selected>--Select Publisher Name--</option>
            </select>
            <span asp-validation-for="BookVModel.PublisherId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="@Model.AuthorIds">Author Name</label>
            <select asp-for="@Model.AuthorIds" asp-items="@ViewBag.AuthorList" class="form-control" multiple>
                <option>--Select Authors--</option>
            </select>
            <span asp-validation-for="@Model.AuthorIds" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary" style="width:150px">Edit</button>
        <a asp-controller="Book" asp-action="Index" class="btn btn-secondary" style="width:150px">
            Back to List
        </a>
    </div>
</form>

<script>
    function loadFile(event) {
        var image = document.getElementById('output');
        var fileName = document.getElementById('fileName');
        var fileLabel = document.getElementById('fileLabel');

        if (event.target.files.length > 0) {
            var file = event.target.files[0];
            image.src = URL.createObjectURL(file);
            fileName.innerText = file.name; // Hiển thị tên file dưới ảnh
            fileLabel.style.display = 'none'; // Ẩn nút chọn ảnh sau khi chọn
        }
    }

    // Ẩn nhãn "Select book photo" nếu đã có ảnh
    window.onload = function() {
        var image = document.getElementById('output');
        var fileLabel = document.getElementById('fileLabel');
        if (image.src && image.src !== window.location.href) {
            fileLabel.style.display = 'none';
        }
    };
</script>