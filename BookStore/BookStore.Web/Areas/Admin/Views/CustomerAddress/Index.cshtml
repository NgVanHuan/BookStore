@model IEnumerable<BookStore.VModels.CustomerAddress.CustomerAddressViewModel>

<!-- Begin Page Content -->
<div class="container-fluid">

    <!-- Page Heading -->
    <h1 class="h3 mb-2 text-gray-800">Customer Address</h1>
    <p class="mb-4">
        ---
    </p>

    <!-- DataTales Example -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <a asp-area="Admin" asp-controller="CustomerAddress" asp-action="Create" type="button" class="btn btn-success">Create Customer Address</a>
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table id="dataTable" class="table table-striped table-bordered" style="width:100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>AddressId</th>
                            <th>Customer Acc</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.AddressId</td>
                                <td>@item.Customer.Email</td>
                                <td>@item.Address.StreetNumber, @item.Address.StreetName @item.Address.City</td>
                                <td>@item.AddressStatus.AddressStatusName</td>
                                <td>
                                    @* <button type="button" class="btn btn-info">Info</button> *@
                                    <a type="button" asp-area="Admin" asp-controller="CustomerAddress" asp-action="Edit" asp-route-addressId="@item.AddressId" class="btn btn-warning">Edit</a>
                                    <a type="button" asp-area="Admin" asp-controller="CustomerAddress" asp-action="Delete" asp-route-addressId="@item.AddressId" class="btn btn-danger" onclick="return confirmDelete()">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>AddressId</th>
                            <th>Customer Acc</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- /.container-fluid -->

<script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this Customer address?');
    }
</script>