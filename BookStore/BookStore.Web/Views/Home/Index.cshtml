@model HomePageViewModel

@{
    ViewData["Title"] = "Home Page";
}

<style>
	/* Nút thường */
	.pagination .page-link {
		color: orange;
		border: 1px solid orange;
		background-color: white;
	}

	/* Hover */
	.pagination .page-link:hover {
		background-color: orange;
		color: black;
	}

	/* Nút đang active */
	.pagination .page-item.active .page-link {
		background-color: orange;
		color: black;
		border-color: orange;
	}

	/* Nút bị disabled */
	.pagination .page-item.disabled .page-link {
		color: #999;
		background-color: #eee;
		border-color: #ccc;
	}
</style>

<main role="main">
	<!-- Start Category -->
	<section id="mu-category-overview">
		<div class="container">
			<div class="row">
				<div class="col-md-12">
                        <div class="mu-category-overview-area">
                            <div class="mu-heading-area">
                                <h2 class="mu-heading-title">Categories</h2>
                                <span class="mu-header-dot"></span>
                            </div>
                            <!-- Start Book Overview Content -->
							<div id="category-list" class="row">
								@foreach (var item in Model.FeatureCategories)
								{
									<div class="col-md-3 col-sm-6">
										<div class="mu-single-counter">
											<i class="fa fa-files-o" aria-hidden="true"></i>
										<div class="counter-value">@item.Number</div>
										<a class="btn btn-category" aria-hidden="true" data-category-id="@item.CategoryId">
											<h5 class="mu-counter-name category-link" data-category-id="@item.CategoryId">@item.CategoryName</h5>
										</a>
										</div>
									</div>
								}
							</div>
                            <!-- / Single Counter -->

                            <!-- Pagination Controls -->
							<div class="row" style="margin-top:20px;">
								<div class="col-md-12 text-center">
									<nav aria-label="Category pagination">
										<ul id="category-pagination" class="pagination justify-content-center">
											<li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
												<a class="page-link" href="#" data-page="@(@Model.CurrentPage - 1)">Previous</a>
											</li>
											@for (int i = 1; i <= Model.TotalPages; i++)
											{
												<li class="page-item @(i == Model.CurrentPage ? "active" : "")">
													<a class="page-link" href="#" data-page="@i">@i</a>
												</li>
											}
											<li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
												<a class="page-link" href="#" data-page="@(@Model.CurrentPage + 1)">Next</a>
											</li>
										</ul>
									</nav>
								</div>
							</div>
                            <!-- End Pagination Controls -->
                        </div>
                    </div>
				</div>
			</div>
		</div>
	</section>
