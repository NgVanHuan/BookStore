	<script>
		document.addEventListener("DOMContentLoaded", function () {
			// Xử lý sự kiện "Add to Cart"
			// document.querySelectorAll(".btn-add-to-cart").forEach(button => {
			// 	button.addEventListener("click", function () {
			// 		const bookId = this.getAttribute("data-book-id");
			// 		fetch('/Cart/AddToCart?bookId=' + bookId)
			// 		.then(response => {
			// 			if (response.ok) {
			// 				alert('Book added to cart!');
			// 				location.reload(); // Reload the page to update cart count
			// 				// updateCartCount();
			// 			} else {
			// 				alert('Failed to add book to cart.');
			// 			}
			// 		})
			// 		.catch(error => console.error("Error adding to cart:", error));
			// 	});
			// });
			// Cập nhật số lượng sản phẩm trong giỏ hàng
			function updateCartCount() {
				fetch('/Home/GetCartCount')
					.then(response => response.json())
					.then(data => {
						document.getElementById("cart-count").innerText = data.count;
					})
					.catch(error => console.error("Error fetching cart count:", error));
			}
			
			// Event delegation for dynamically loaded .btn-add-to-cart
			document.getElementById("book-list").addEventListener("click", function (e) {
				if (e.target.classList.contains("btn-add-to-cart")) {
					const bookId = e.target.getAttribute("data-book-id");
					const title = e.target.getAttribute("data-book-title");
					const btn = e.target.closest(".btn-add-to-cart");
					if (!btn) return; // không phải nút thì bỏ qua

					// const bookId = btn.getAttribute("data-book-id");
					if (!bookId) return;
					fetch('/Cart/AddToCart?bookId=' + bookId).then(response => {
						if (response.ok) {
							alert('Book added to cart!');
							// location.reload(); // Reload the page to update cart count
							updateCartCount();
						} else {
							alert('Failed to add book to cart.');
						}
					})
					.catch(error => console.error("Error adding to cart:", error));
				}
			});

			// Xử lý sự kiện phân trang category
			document.getElementById("category-pagination").addEventListener("click", function (e) {
				if (e.target.tagName === "A" && e.target.hasAttribute("data-page")) {
					e.preventDefault();
					const page = parseInt(e.target.getAttribute("data-page"));
					if (!isNaN(page)) {
						loadCategories(page);
					}
				}
			});

			function loadCategories(page) {
				fetch(`/Home/GetPagedCategories?page=${page}`)
					.then(response => response.json())
					.then(data => {
						// Render lại danh sách category
						const categoryList = document.getElementById("category-list");
						categoryList.innerHTML = "";
						data.categories.forEach(item => {
							categoryList.innerHTML += `
								<div class="col-md-3 col-sm-6">
									<div class="mu-single-counter">
										<i class="fa fa-files-o" aria-hidden="true"></i>
									<div class="counter-value">${item.number}</div>
									<a class="btn btn-category" aria-hidden="true" data-category-id="${item.categoryId}">
										<h5 class="mu-counter-name category-link" data-category-id="${item.categoryId}">${item.categoryName}</h5>
									</a>
									</div>
								</div>
							`;
						});

						// Render lại phân trang
						const pagination = document.getElementById("category-pagination");
						let html = '';
						html += `<li class="page-item ${data.currentPage == 1 ? "disabled" : ""}">
									<a class="page-link" href="#" data-page="${data.currentPage - 1}">Previous</a>
								</li>`;
						for (let i = 1; i <= data.totalPages; i++) {
							html += `<li class="page-item ${i == data.currentPage ? "active" : ""}">
										<a class="page-link" href="#" data-page="${i}">${i}</a>
									</li>`;
						}
						html += `<li class="page-item ${data.currentPage == data.totalPages ? "disabled" : ""}">
									<a class="page-link" href="#" data-page="${data.currentPage + 1}">Next</a>
								</li>`;
						pagination.innerHTML = html;
					});
				}
			// Xử lý sự kiện click vào tên category
		document.getElementById("category-list").addEventListener("click", function (e) {
			if (e.target.classList.contains("category-link")) {
				const categoryId = e.target.getAttribute("data-category-id");
				loadBooksByCategory(categoryId);
			}
		});

		function loadBooksByCategory(categoryId) {
			fetch(`/Home/GetBooksByCategory?categoryId=${categoryId}`)
				.then(response => response.json())
				.then(data => {
					const bookList = document.getElementById("book-list");
					bookList.innerHTML = "";
					data.forEach(item => {
						const imgPath = `/img/book/${item.imageName}`;
						bookList.innerHTML += `
							<div class="col-md-3 col-sm-6">
								<div class="mu-book-overview-single flex-column d-flex">
									<a href="/BookDetail/Index?bookId=${item.bookId}">
										<span class="mu-book-overview-icon-box">
											<img src="${imgPath}" alt="${item.imageName}" width="150" height="200" />
										</span>
										<h4 style="height: 50px">${item.title}</h4>
									</a>
									<div class="row mt-auto">
										<div class="col-md-8" style="color: red; font-weight:bolder; font-size: xx-large">
											$ ${item.price}
										</div>
										<div class="col-md-4">
											<button style="height:48px" class="btn btn-warning btn-add-to-cart" data-book-id="${item.bookId}" data-book-title="${item.title.replace(/"/g, '&quot;')}">
												<i class="fa fa-cart-plus"></i>
											</button>
										</div>
									</div>
									<p></p>
								</div>
							</div>
						`;
					});
				});
		}
			});
	</script>